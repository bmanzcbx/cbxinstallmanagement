generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id         String   @id @default(cuid())
  roomId     String
  clientName String
  location   String
  botCount   Int
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING_APPROVAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bookings")
}
